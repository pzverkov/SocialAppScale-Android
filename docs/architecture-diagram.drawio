<mxfile host="app.diagrams.net">
  <diagram id="arch" name="SocialApp Architecture">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" math="0" shadow="0" pageWidth="1400" pageHeight="900">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- ============ BASIC PANEL ============ -->
        <mxCell id="bpanel" value="" style="rounded=1;fillColor=#fbfbfb;strokeColor=#bbbbbb;dashed=1;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="440" height="560" as="geometry"/>
        </mxCell>
        <mxCell id="btitle" value="SocialApp-basic&#10;single :app module, package layers - Hilt DI" style="text;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="50" width="400" height="44" as="geometry"/>
        </mxCell>

        <mxCell id="b_ui" value="Compose UI - Single Activity&#10;Screens: itemlist, itemdetail (Navigation Compose)" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="70" y="110" width="380" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="b_vm" value="ViewModel + Store&lt;State, Event&gt;&#10;StateFlow down / SharedFlow one-shot events" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="70" y="196" width="380" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="b_dom" value="Repository interfaces (domain)&#10;ItemRepository, FavoriteRepository - typed ErrorType" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">

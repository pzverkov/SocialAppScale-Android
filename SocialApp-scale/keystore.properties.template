# Release signing credentials.
#
# Copy this file to keystore.properties (gitignored) and fill in real values,
# or set the equivalent environment variables in CI:
#   storeFile     -> KEYSTORE_FILE
#   storePassword -> KEYSTORE_PASSWORD
#   keyAlias      -> KEY_ALIAS
#   keyPassword   -> KEY_PASSWORD
#
# Generate a keystore with:
#   keytool -genkeypair -v -keystore release.jks -alias socialapp \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile is resolved relative to the app module directory.

storeFile=release.jks
storePassword=
keyAlias=socialapp
keyPassword=
